[node name="DiffFairnessNotice" type="Label" parent="VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.5, 0.75, 0.6, 0.85)
theme_override_font_sizes/font_size = 9
text = "Fairness: Scaled attributes affect alien behaviors only. Player health is never modified."

[node name="LaunchAIArenaButton" type="Button" parent="VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.2, 1, 0.7, 1)
theme_override_font_sizes/font_size = 12
text = "★ Launch AI vs AI Simulation Arena"

[node name="HintLabel" type="Label" parent="VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.4, 0.55, 0.7, 0.8)
theme_override_font_sizes/font_size = 10
text = "Press [F1] or click HUD button to show/hide this menu during gameplay."
